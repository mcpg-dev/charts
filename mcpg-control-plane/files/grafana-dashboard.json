{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {"type": "datasource", "uid": "grafana"},
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "MCPG Control Plane — HTTP traffic, error ratio, license refresh, and tenant activity. The `job` variable selects the CP scrape job (the chart's Service name); the HTTP families use generic metric names, so every query is job-scoped.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "row",
      "title": "Service",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Scrape target up",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "min(up{job=~\"$job\"})",
          "legendFormat": "up",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"]}
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          },
          "unit": "short"
        }
      }
    },
    {
      "type": "stat",
      "title": "Request rate (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(mcpg_cp_http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat",
      "title": "5xx ratio (5m)",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(mcpg_cp_http_requests_total{job=~\"$job\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(mcpg_cp_http_requests_total{job=~\"$job\"}[5m])), 1e-9)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "colorMode": "background"}
    },
    {
      "type": "stat",
      "title": "Enrollments (24h)",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "sum(increase(mcpg_cp_enrollments_total{job=~\"$job\"}[24h]))",
          "legendFormat": "enrollments",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "row",
      "title": "HTTP traffic",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Requests by route class",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "sum by (route_class) (rate(mcpg_cp_http_requests_total{job=~\"$job\"}[5m]))",
          "legendFormat": "{{route_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "type": "timeseries",
      "title": "5xx ratio",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "sum(rate(mcpg_cp_http_requests_total{job=~\"$job\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(mcpg_cp_http_requests_total{job=~\"$job\"}[5m])), 1e-9)",
          "legendFormat": "5xx ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1, "min": 0}}
    },
    {
      "type": "row",
      "title": "Platform activity",
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "License refresh outcomes (1h window)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "sum by (outcome) (increase(mcpg_cp_license_refresh_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    },
    {
      "type": "timeseries",
      "title": "Publishes by outcome (1h window)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "datasource": {"type": "prometheus"},
      "targets": [
        {
          "expr": "sum by (outcome) (increase(mcpg_cp_publishes_total{job=~\"$job\"}[1h]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "short"}}
    }
  ],
  "schemaVersion": 38,
  "tags": ["mcpg", "control-plane"],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "job",
        "type": "query",
        "datasource": {"type": "prometheus"},
        "query": "label_values(up, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": {"from": "now-1h", "to": "now"},
  "timezone": "",
  "title": "MCPG Control Plane",
  "uid": "mcpg-control-plane",
  "version": 1
}
